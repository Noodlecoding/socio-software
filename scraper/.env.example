# Copy to scraper/.env (git-ignored). Never commit real keys.
SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
# Supabase dashboard > Project Settings > API > service_role key. Keep it secret:
# it bypasses RLS. It is only used by this script, on your own machine.
SUPABASE_SERVICE_ROLE_KEY=""
# Optional, free: https://developer.company-information.service.gov.uk/
# Without it, Ltd status is guessed from the name ("Ltd", "Limited", "LLP").
COMPANIES_HOUSE_API_KEY=""
